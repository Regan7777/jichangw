---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');

const staticItems = [
  {
    title: '实用极客工具箱（订阅转换、测速、NextTrace、WebRTC检测）',
    description: '全平台订阅转换、ACL4SSR分流规则、Ookla/Fast/SEET多节点测速、风控检测与路由追踪。',
    url: '/tools',
    category: '工具箱',
    tags: ['工具', '订阅转换', '测速', 'NextTrace', 'WebRTC'],
  },
  {
    title: '网络服务商风险防范与避坑准则（立站初衷与5大风控哲学）',
    description: '揭秘行业假专线、大促跑路资金盘、暗改倍率套路，建立双链路冗余与应急SOP。',
    url: '/risk',
    category: '避坑预警',
    tags: ['风险', '避坑', '跑路', '专线', '风控', '安全'],
  },
];

const postItems = allPosts.map((p) => ({
  title: p.data.title,
  description: p.data.description,
  url: `/articles/${p.slug.replace(/^articles\//, '')}`,
  category: p.data.category === 'pingce' ? '机场评测' : p.data.category === 'jiaocheng' ? '客户端教程' : '技术文章',
  tags: [...(p.data.tags || []), ...(p.data.keywords || [])],
}));

const searchIndex = [...postItems, ...staticItems];
---

<div class="relative search-container" id="site-search-wrapper">
  <div class="relative flex items-center">
    <svg
      class="absolute left-2.5 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-slate-400 pointer-events-none"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input
      type="text"
      id="site-search-input"
      placeholder="搜索评测/客户端/节点..."
      class="h-8 w-36 sm:w-48 md:w-56 lg:w-64 rounded-md border border-slate-200 bg-slate-50/80 pl-8 pr-12 text-xs text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-slate-400 focus:outline-none focus:ring-1 focus:ring-slate-400 transition-all"
      autocomplete="off"
    />
    <kbd class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 hidden sm:inline-flex h-4 items-center gap-0.5 rounded border border-slate-200 bg-white px-1 font-mono text-[9px] font-medium text-slate-400">
      <span class="text-[10px]">Ctrl</span>K
    </kbd>
  </div>

  <!-- Search Results Dropdown -->
  <div
    id="site-search-results"
    class="hidden absolute right-0 sm:left-0 sm:right-auto top-full mt-2 w-80 sm:w-96 max-h-96 overflow-y-auto rounded-xl border border-slate-200 bg-white p-2 shadow-xl z-50 divide-y divide-slate-100"
  >
    <div id="search-results-list" class="space-y-1 py-1"></div>
    <div id="search-no-results" class="hidden p-4 text-center text-xs text-slate-500 font-mono">
      未找到相关评测或教程，换个关键词试试
    </div>
  </div>
</div>

<script define:vars={{ searchIndex }}>
  const input = document.getElementById('site-search-input');
  const resultsContainer = document.getElementById('site-search-results');
  const resultsList = document.getElementById('search-results-list');
  const noResults = document.getElementById('search-no-results');
  const wrapper = document.getElementById('site-search-wrapper');

  function doSearch(query) {
    if (!query || !query.trim()) {
      resultsContainer.classList.add('hidden');
      return;
    }
    const q = query.trim().toLowerCase();
    const filtered = searchIndex.filter((item) => {
      const matchTitle = item.title.toLowerCase().includes(q);
      const matchDesc = item.description.toLowerCase().includes(q);
      const matchTags = item.tags.some((t) => t.toLowerCase().includes(q));
      const matchCat = item.category.toLowerCase().includes(q);
      return matchTitle || matchDesc || matchTags || matchCat;
    });

    resultsList.innerHTML = '';
    if (filtered.length === 0) {
      noResults.classList.remove('hidden');
    } else {
      noResults.classList.add('hidden');
      filtered.slice(0, 8).forEach((item) => {
        const a = document.createElement('a');
        a.href = item.url;
        a.className = 'search-item block p-2.5 rounded-lg hover:bg-slate-50 transition-colors text-left group';
        a.innerHTML = `
          <div class="flex items-center justify-between gap-2 mb-1">
            <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-mono font-medium ${
              item.category === '机场评测'
                ? 'bg-blue-50 text-blue-700 border border-blue-200'
                : item.category === '客户端教程'
                ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                : 'bg-slate-100 text-slate-700 border border-slate-200'
            }">${item.category}</span>
            <span class="text-[10px] font-mono text-slate-400 group-hover:text-slate-900 transition-colors">前往阅读 →</span>
          </div>
          <div class="text-xs font-semibold text-slate-900 group-hover:text-slate-700 line-clamp-1">${item.title}</div>
          <p class="text-[11px] text-slate-500 line-clamp-1 mt-0.5 leading-normal">${item.description}</p>
        `;
        resultsList.appendChild(a);
      });
    }
    resultsContainer.classList.remove('hidden');
    activeIndex = -1;
  }

  input?.addEventListener('input', (e) => {
    doSearch(e.target.value);
  });

  input?.addEventListener('focus', () => {
    if (input.value.trim()) {
      doSearch(input.value);
    }
  });

  // Keyboard shortcut Ctrl+K / Cmd+K / Slash
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      input?.focus();
      input?.select();
    } else if (e.key === 'Escape') {
      resultsContainer?.classList.add('hidden');
      input?.blur();
    }
  });

  // Close when clicked outside
  document.addEventListener('click', (e) => {
    if (wrapper && !wrapper.contains(e.target)) {
      resultsContainer?.classList.add('hidden');
    }
  });
</script>
