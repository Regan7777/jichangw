---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="space-y-3">
  {items.map((item, index) => (
    <details class="group border border-slate-200 rounded-lg bg-white overflow-hidden transition-colors hover:border-slate-300">
      <summary class="flex items-center justify-between p-4 text-xs font-semibold text-slate-900 cursor-pointer select-none">
        <span class="flex items-center gap-2">
          <span class="font-mono text-slate-400">Q{index + 1}.</span>
          <span>{item.question}</span>
        </span>
        <span class="text-slate-400 group-open:rotate-180 transition-transform font-mono text-sm">
          ↓
        </span>
      </summary>
      <div class="px-4 pb-4 pt-1 text-xs text-slate-600 leading-relaxed border-t border-slate-100 bg-slate-50/50">
        <p>{item.answer}</p>
      </div>
    </details>
  ))}
</div>

