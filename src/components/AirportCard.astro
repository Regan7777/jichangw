---
interface Props {
  name: string;
  tagline: string;
  lineType: string;
  protocols: string;
  pricing: string;
  unlock: string;
  pros: string[];
  cons: string[];
  affUrl: string;
  reviewUrl: string;
}

const {
  name,
  tagline,
  lineType,
  protocols,
  pricing,
  unlock,
  pros,
  cons,
  affUrl,
  reviewUrl,
} = Astro.props;
---

<div class="border border-slate-200 rounded-lg p-5 bg-white hover:border-slate-300 transition-all flex flex-col justify-between">
  <div>
    <div class="flex items-start justify-between gap-3 border-b border-slate-100 pb-3 mb-3">
      <div>
        <h3 class="font-semibold text-base text-slate-900">{name}</h3>
        <p class="text-xs text-slate-500 mt-1 line-clamp-1">{tagline}</p>
      </div>
      <div class="text-right shrink-0">
        <span class="font-mono text-sm font-semibold text-slate-900">{pricing}</span>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-2 text-xs mb-4 font-mono text-slate-600">
      <div class="bg-slate-50 p-2 rounded">
        <span class="text-slate-400 block text-[10px]">线路类型</span>
        <span class="font-medium text-slate-800">{lineType}</span>
      </div>
      <div class="bg-slate-50 p-2 rounded">
        <span class="text-slate-400 block text-[10px]">核心协议</span>
        <span class="font-medium text-slate-800">{protocols}</span>
      </div>
      <div class="bg-slate-50 p-2 rounded">
        <span class="text-slate-400 block text-[10px]">流媒体与AI</span>
        <span class="font-medium text-slate-800 truncate block">{unlock}</span>
      </div>
      <div class="bg-slate-50 p-2 rounded">
        <span class="text-slate-400 block text-[10px]">状态核验</span>
        <span class="font-medium text-emerald-800 text-[11px] truncate block">官网与优惠实时有效</span>
      </div>
    </div>

    <div class="space-y-1.5 text-xs mb-4">
      <div class="text-slate-700 flex items-start gap-1.5">
        <span class="text-emerald-700 font-bold shrink-0">[优势]</span>
        <span class="text-slate-600">{pros.join('；')}</span>
      </div>
      <div class="text-slate-700 flex items-start gap-1.5">
        <span class="text-amber-700 font-bold shrink-0">[说明]</span>
        <span class="text-slate-600">{cons.join('；')}</span>
      </div>
    </div>
  </div>

  <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
    <a
      href={reviewUrl}
      class="text-xs text-slate-500 hover:text-slate-900 underline underline-offset-4"
    >
      查阅详细核验报告
    </a>
    <a
      href={affUrl}
      target="_blank"
      rel="sponsored noopener noreferrer"
      class="px-3 py-1.5 text-xs font-medium rounded bg-slate-900 text-white hover:bg-slate-800 transition-colors inline-flex items-center gap-1"
    >
      <span>前往官网直达通道</span>
      <span>→</span>
    </a>
  </div>
</div>
