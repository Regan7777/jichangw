---
// Clean Tech Minimalist Back-to-Top Component
---

<button
  id="back-to-top"
  type="button"
  aria-label="返回顶部"
  class="fixed bottom-6 right-6 z-50 flex h-9 w-9 items-center justify-center rounded border border-slate-300 bg-white/95 text-slate-700 shadow-sm backdrop-blur transition-all duration-200 opacity-0 pointer-events-none hover:bg-slate-900 hover:text-white hover:border-slate-900 focus:outline-none"
>
  <svg
    class="h-4 w-4"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M18 15l-6-6-6 6"></path>
  </svg>
</button>

<script>
  function initBackToTop() {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;

    const onScroll = () => {
      if (window.scrollY > 280) {
        btn.classList.remove('opacity-0', 'pointer-events-none');
        btn.classList.add('opacity-100', 'pointer-events-auto');
      } else {
        btn.classList.add('opacity-0', 'pointer-events-none');
        btn.classList.remove('opacity-100', 'pointer-events-auto');
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });

    btn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    });
  }

  // Support Astro view transitions or initial load
  initBackToTop();
  document.addEventListener('astro:page-load', initBackToTop);
</script>

