<div class="overflow-x-auto border border-slate-200 rounded-lg bg-white shadow-sm">
  <table class="w-full text-left text-xs border-collapse">
    <thead>
      <tr class="bg-slate-50 border-b border-slate-200 text-slate-700 font-semibold">
        <th class="py-3 px-3.5">服务商名称</th>
        <th class="py-3 px-3.5">线路类型</th>
        <th class="py-3 px-3.5">参考资费</th>
        <th class="py-3 px-3.5">流媒体与AI支持</th>
        <th class="py-3 px-3.5">推荐适用场景</th>
        <th class="py-3 px-3.5">实时核验优惠码</th>
        <th class="py-3 px-3.5 text-right">核验报告 / 通道</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {airports.map((item) => (
        <tr class="hover:bg-slate-50/80 transition-colors">
          <td class="py-3 px-3.5 font-medium text-slate-900 flex items-center gap-1.5 whitespace-nowrap">
            <span class="h-1.5 w-1.5 rounded-full bg-slate-900"></span>
            <span>{item.name}</span>
          </td>
          <td class="py-3 px-3.5 font-mono text-slate-600 whitespace-nowrap">{item.tag}</td>
          <td class="py-3 px-3.5 text-slate-700 font-mono whitespace-nowrap">{item.price}</td>
          <td class="py-3 px-3.5 text-slate-600">{item.unlock}</td>
          <td class="py-3 px-3.5 text-slate-500">{item.scene}</td>
          <td class="py-3 px-3.5 whitespace-nowrap">
            <span class="inline-flex items-center font-mono text-[11px] bg-slate-50 border border-dashed border-slate-300 px-2 py-0.5 rounded text-slate-800 font-semibold">
              {item.coupon}
            </span>
          </td>
          <td class="py-3 px-3.5 text-right space-x-1.5 whitespace-nowrap">
            <a
              href={item.reviewUrl}
              class="inline-block px-2 py-1 text-[11px] rounded border border-slate-200 text-slate-600 hover:text-slate-900 hover:bg-slate-100"
            >
              详细报告
            </a>
            <a
              href={item.url}
              target="_blank"
              rel="sponsored noopener noreferrer"
              class="inline-block px-2.5 py-1 text-[11px] font-medium rounded bg-slate-900 text-white hover:bg-slate-800 transition-colors"
            >
              官网通道
            </a>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
